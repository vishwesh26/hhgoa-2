# ===================================================
# VAANI - Voice-Enabled Multilingual Adaptive RAG Engine
# Environment Configuration Template
# ===================================================

# Sarvam AI STT Credentials
SARVAM_API_KEY=your_sarvam_api_key_here
SARVAM_STT_MODEL=saarika:v2.5
SARVAM_STT_URL=https://api.sarvam.ai/speech-to-text

# Google Gemini LLM Credentials
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
GEMINI_FALLBACK_MODEL=gemini-3.1-pro-preview

# Qdrant Vector Database
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_API_KEY=
QDRANT_COLLECTION_PREFIX=vaani_msmarco
QDRANT_USE_EMBEDDED=true
QDRANT_STORAGE_PATH=./data/qdrant_storage

# Embedding Model Configuration
EMBEDDING_MODEL_NAME=sentence-transformers/paraphrase-multilingual-mpnet-base-v2
EMBEDDING_DIMENSION=768
EMBEDDING_USE_ONNX=true

# Reranker Configuration
RERANKER_MODEL_NAME=ms-marco-MiniLM-L-12-v2
RERANKER_TOP_K=15
FINAL_CONTEXT_K=5

# BM25 Lexical Search Configuration
BM25_INDEX_DIR=./data/bm25_indices
BM25_TOP_K=20

# Hybrid Search Fusion & Weights
VECTOR_TOP_K=20
RRF_K=60
VECTOR_WEIGHT=0.5
BM25_WEIGHT=0.5

# Guardrails & Confidence Thresholds
RETRIEVAL_CONFIDENCE_THRESHOLD=0.38
GROUNDING_VERIFICATION_THRESHOLD=0.50

# Server & Performance
PORT=8000
HOST=0.0.0.0
ENABLE_QUERY_CACHE=true
CACHE_MAX_SIZE=1000
LOG_LEVEL=INFO
